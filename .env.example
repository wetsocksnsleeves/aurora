# Port the custom server (server.ts) listens on.
PORT=3000
# Public base URL the QR code points to (no trailing slash).
# In demos set this to the HTTPS tunnel URL, e.g. https://example.trycloudflare.com
PUBLIC_URL=http://localhost:3000
# Extra hostnames the API answers to, comma-separated (ports ignored), e.g. a
# LAN address: ALLOWED_HOSTS=192.168.1.20,aurora.local
# localhost, 127.0.0.1, [::1] and the PUBLIC_URL host are always allowed.
ALLOWED_HOSTS=
# Lead time in ms from the host clicking Start to the show's T0 (SPEC 4.6).
# Every phone already holds its schedule, so 900 is enough on good wifi; raise
# it (e.g. 2000) on a slow venue network.
START_LEAD_MS=900
