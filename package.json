{
  "name": "aurora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore './.next/**' --ignore './app/**' server.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/server.mjs && esbuild server/compile-worker.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/compile-worker.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/sim.ts",
    "test:e2e": "echo 'test:e2e: no browser tests yet (DEVELOPMENT.md chunk 7)' && exit 0"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wavesurfer.js": "^8.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
